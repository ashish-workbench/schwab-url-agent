import pytest
from fastapi.testclient import TestClient

from app import main, store


@pytest.fixture
def client(tmp_path, monkeypatch):
    monkeypatch.setenv("SHORTENER_DB", str(tmp_path / "api.db"))
    with TestClient(main.app) as c:
        yield c


def _create(client, **body):
    body.setdefault("url", "https://example.com/landing")
    return client.post("/links", json=body)


def test_health(client):
    assert client.get("/healthz").json() == {"status": "ok"}


def test_create_redirect_and_count(client):
    created = _create(client)
    assert created.status_code == 201
    code = created.json()["code"]
    hop = client.get(f"/{code}", follow_redirects=False)
    assert hop.status_code == 302
    assert hop.headers["location"] == "https://example.com/landing"
    client.get(f"/{code}", follow_redirects=False)
    assert client.get(f"/links/{code}/stats").json()["clicks"] == 2


def test_unknown_code_returns_404(client):
    assert client.get("/zzzzzzz", follow_redirects=False).status_code == 404
    assert client.get("/links/zzzzzzz/stats").status_code == 404


@pytest.mark.parametrize("url", ["javascript:alert(1)", "https://u:p@example.com", ""])
def test_rejects_bad_urls(client, url):
    assert _create(client, url=url).status_code == 422


def test_rejects_oversized_url(client):
    long_url = "https://example.com/" + "a" * store.MAX_URL_LENGTH
    assert _create(client, url=long_url).status_code == 422


def test_malformed_code_rejected(client):
    assert client.get("/bad-code!", follow_redirects=False).status_code == 422


def test_stats_expose_no_pii(client):
    code = _create(client).json()["code"]
    client.get(f"/{code}", follow_redirects=False, headers={"User-Agent": "probe"})
    body = client.get(f"/links/{code}/stats").json()
    assert not {"ip", "user_agent", "email"} & set(body)
# @if expiry


@pytest.mark.parametrize("ttl", [0, -5])
def test_rejects_invalid_ttl(client, ttl):
    assert _create(client, ttl_seconds=ttl).status_code == 422


def test_expired_link_returns_410(client, monkeypatch):
    code = _create(client, ttl_seconds=60).json()["code"]
    monkeypatch.setattr(store, "_now", lambda: 10**12)
    assert client.get(f"/{code}", follow_redirects=False).status_code == 410
    assert client.get(f"/links/{code}/stats").json()["expired"] is True
